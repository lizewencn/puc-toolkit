{
  "generatedFrom": "captured-session.har",
  "protocol": "puc-command",
  "token": { "responsePath": "token", "headerName": "token", "prefix": "" },
  "pucId": { "responsePath": "common_info.puc_id" },
  "captcha": { "idResponsePath": "uuid", "imageResponsePath": "captcha" },
  "operations": {
    "commonConfig": {
      "method": "POST", "path": "/confs", "headers": { "Accept": "application/json, text/plain, */*" },
      "bodyTemplate": { "cmd_name": "common_cfg_request" }
    },
    "captcha": {
      "method": "POST", "path": "/confs", "headers": { "Accept": "application/json, text/plain, */*" },
      "bodyTemplate": { "cmd_name": "puc_get_captcha", "height": 34, "width": 120 }
    },
    "login": {
      "method": "POST", "path": "/confs", "headers": { "Accept": "application/json, text/plain, */*" },
      "bodyTemplate": { "realm": "{{realm}}", "puc_account": "{{username}}", "puc_passwd": "{{password}}", "captcha_id": "{{captchaId}}", "captcha_value": "{{captchaValue}}", "puc_id": "{{pucId}}", "cmd_name": "login_puc_account" },
      "selectors": { "success": "result", "successExpected": 0 }
    },
    "organizations": {
      "method": "POST", "path": "/confs", "headers": { "Accept": "application/json, text/plain, */*" },
      "bodyTemplate": { "cmd_name": "personnel_organization_list_req", "puc_id": "{{pucId}}", "user_id": "{{username}}", "realm": "{{realm}}", "custom_org_id": "", "is_recursive_qry": 0 },
      "selectors": { "rows": "organization_info_list", "id": "custom_org_id", "name": "custom_org_alias" }
    },
    "searchPersonnel": {
      "method": "POST", "path": "/confs", "headers": { "Accept": "application/json, text/plain, */*" },
      "bodyTemplate": { "cmd_name": "custom_police_info_list_req", "cmd_guid": "{{commandGuid}}", "puc_id": "{{pucId}}", "user_id": "{{username}}", "realm": "{{realm}}", "version": "10", "product_name": "PUC", "querykey": "{{query}}", "page_index": 1, "page_sizes": 100, "is_fuzzy_qry": 1, "custom_org_id": "", "mount_flag": 2, "number_type": 102 },
      "selectors": { "rows": "police_info_list", "officerId": "officer_id", "idNumber": "id_number", "mobile": "mobile" }
    },
    "createPersonnel": {
      "method": "POST", "path": "/confs", "headers": { "Accept": "application/json, text/plain, */*" },
      "bodyTemplate": {
        "cmd_name": "conf_add_personnel_info_req", "cmd_guid": "{{commandGuid}}", "puc_id": "{{pucId}}", "user_id": "{{username}}", "realm": "{{realm}}", "version": "10", "product_name": "PUC", "avatar_url": "", "avatar_md5sum": "",
        "personnel_info": { "enforce_bind_dispatcher": 0, "enforce_bind_device": 0, "update_dev": 0, "number_type": 102, "officer_id": "{{officerId}}", "tampered": 0, "police_alias": "{{alias}}", "police_type_guid": "{{policeTypeGuid}}", "custom_org_id": "{{organizationId}}", "custom_org_alias": "{{organizationName}}", "id_number": "{{idNumber}}", "mobile": "{{mobile}}", "device_guid_list": [], "sort_id": null }
      },
      "selectors": { "success": "result", "successExpected": 0 }
    }
  }
}
